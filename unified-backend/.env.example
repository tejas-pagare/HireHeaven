# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DB_URL=postgresql://user:password@host/dbname?sslmode=require

# ──────────────────────────────────────────────
# REDIS (Upstash)
# ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Direct Redis URL (used by some services)
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# AUTH / JWT
# ──────────────────────────────────────────────
JWT_SEC=your_super_secret_jwt_key

# ──────────────────────────────────────────────
# EMAIL (Nodemailer via Gmail SMTP)
# ──────────────────────────────────────────────
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ──────────────────────────────────────────────
# CLOUDINARY
# ──────────────────────────────────────────────
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret

# ──────────────────────────────────────────────
# AI (Groq)
# ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ──────────────────────────────────────────────
# PAYMENT (Razorpay)
# ──────────────────────────────────────────────
Razorpay_Key=your_razorpay_key_id
Razorpay_Secret=your_razorpay_key_secret

# ──────────────────────────────────────────────
# URLS
# ──────────────────────────────────────────────
Frontend_Url=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Upload service base URL used by other services
UPLOAD_SERVICE=http://localhost:4000

# Kafka broker (if using Kafka)
Kafka_Broker=localhost:9092

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=5000
